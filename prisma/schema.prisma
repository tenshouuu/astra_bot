generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Conversation {
  id        String               @id
  updatedAt DateTime             @updatedAt
  messages  Message[]
  summary   ConversationSummary?
}

model Message {
  id             BigInt       @id @default(autoincrement())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  externalId     String       @unique
  role           String
  author         String
  text           String
  sentAt         DateTime

  @@index([conversationId, id])
  @@index([sentAt])
}

model ConversationSummary {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  text           String       @default("")
  throughId      BigInt       @default(0)
  version        Int          @default(0)
}

model ModerationParticipant {
  chatId       BigInt
  userId       BigInt
  firstSeenAt  DateTime
  messageCount Int      @default(0)

  @@id([chatId, userId])
}

model ModerationMessage {
  sourceId  String   @id
  chatId    BigInt
  userId    BigInt
  messageId Int
  topicId   Int      @default(0)
  text      String
  sentAt    DateTime

  @@index([chatId, userId, sentAt])
  @@index([sentAt])
  @@index([chatId, topicId, sentAt])
}

model ModerationCase {
  id                    String   @id @default(uuid())
  updateId              Int      @unique
  chatId                BigInt
  userId                BigInt
  messageId             Int
  topicId               Int      @default(0)
  action                String   @default("ban")
  requestedBy           BigInt?
  text                  String
  replyText             String
  authorLabel           String
  isBot                 Boolean
  firstSeenAt           DateTime
  messageCount          Int
  sentAt                DateTime
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  expiresAt             DateTime
  status                String   @default("queued")
  attempts              Int      @default(0)
  availableAt           DateTime @default(now())
  category              String?
  reason                String?
  notificationMessageId Int?
  decidedBy             BigInt?
  decidedAt             DateTime?

  @@index([status, availableAt])
  @@index([chatId, userId, status])
  @@index([chatId, messageId, updateId])
  @@index([expiresAt])
}
