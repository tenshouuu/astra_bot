{
  "name": "astra-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram moderation and AI assistant service",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "node scripts/format-root.mjs --write",
    "format:check": "node scripts/format-root.mjs --check",
    "test": "tsx --test test/**/*.test.ts",
    "check": "corepack pnpm typecheck && corepack pnpm lint && corepack pnpm format:check && corepack pnpm test && corepack pnpm audit:agents",
    "sync:agents": "node scripts/sync-agents.mjs",
    "audit:agents": "node scripts/audit-agents.mjs"
  },
  "keywords": [
    "fastify",
    "telegram",
    "moderation"
  ],
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "fastify": "^5.12.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.5.2",
    "eslint": "^9.36.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "prettier": "^3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.44.1"
  }
}
