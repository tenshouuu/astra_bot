NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=
OWNER_USERNAME=
# Set the group ID for a private group; it takes precedence over the username.
ALLOWED_CHAT_ID=
ALLOWED_CHAT_USERNAME=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# PostgreSQL connection; fill in your own connection string.
DATABASE_URL=postgresql://astra:dev@host.docker.internal:5432/astra
# Used only by the local Docker Compose database.
POSTGRES_PASSWORD=dev
