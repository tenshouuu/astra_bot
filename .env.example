NODE_ENV=development
HOST=0.0.0.0
PORT=3000
LOG_LEVEL=info
TELEGRAM_BOT_TOKEN=
OWNER_USERNAME=
# Owner is resolved by OWNER_USERNAME among group administrators; start the bot in private chat.
MODERATION_ENABLED=false
# Comma-separated numeric Telegram user IDs immune from suggested and confirmed bans.
PROTECTED_USER_IDS=
# Set the group ID for a private group; it takes precedence over the username.
# One ID or comma-separated IDs, e.g. -1001234567890,-1009876543210
ALLOWED_CHAT_ID=
ALLOWED_CHAT_USERNAME=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna

# PostgreSQL connection; fill in your own connection string.
DATABASE_URL=postgresql://astra:dev@host.docker.internal:5432/astra
# Used only by the local Docker Compose database.
POSTGRES_PASSWORD=dev
